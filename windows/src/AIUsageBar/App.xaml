<Application x:Class="AIUsageBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Placeholders: Theme.Apply replaces these to follow the Windows light/dark setting. -->
            <SolidColorBrush x:Key="PopupBackground" Color="#F9F9F9" />
            <SolidColorBrush x:Key="PopupBorder" Color="#E0E0E0" />
            <SolidColorBrush x:Key="PrimaryText" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SecondaryText" Color="#5F5F5F" />
            <SolidColorBrush x:Key="TrackBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="Divider" Color="#E5E5E5" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#0F000000" />
            <SolidColorBrush x:Key="HoverBackground" Color="#0F000000" />
            <SolidColorBrush x:Key="ErrorBackground" Color="#26FF8C00" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF8C00" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="UpdateBackground" Color="#260067C0" />
            <SolidColorBrush x:Key="NeutralBarBrush" Color="#808080" />

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- A rounded bar; Value is 0–1. -->
            <Style x:Key="UsageBar" TargetType="ProgressBar">
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource TrackBrush}" />
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat icon button (refresh, open, settings). -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" CornerRadius="4" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One tab per agent: name, fullest limit, underline when selected.
                 Not focusable like the other popup buttons; arrows / Ctrl+Tab switch tabs. -->
            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" CornerRadius="4,4,0,0" Background="Transparent" Padding="4,5,4,0">
                                <StackPanel>
                                    <ContentPresenter HorizontalAlignment="Center" />
                                    <Border Height="2" Margin="0,5,0,0" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One agent's card (name, plan, limits, notes, breakdown): the popup and the taskbar hover card share it. -->
            <DataTemplate x:Key="ProviderCardTemplate">
                <StackPanel>
        <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{DynamicResource BadgeBackground}" Visibility="{Binding PlanVisibility}">
                                <TextBlock Text="{Binding Plan}" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" FontSize="12"
                                Content="&#xE8A7;" ToolTip="{Binding OpenTip}" Command="{Binding OpenCommand}" />
                    </Grid>

                    <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ErrorBackground}"
                            Visibility="{Binding ErrorVisibility}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0" FontFamily="{StaticResource IconFont}"
                                       Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12" />
                        </DockPanel>
                    </Border>

                    <!-- "Too many refreshes": not an error, the last numbers stay below. -->
                    <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource BadgeBackground}"
                            Visibility="{Binding NoticeVisibility}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0" FontFamily="{StaticResource IconFont}"
                                       Text="&#xE823;" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" FontSize="12" />
                        </DockPanel>
                    </Border>

                    <TextBlock Margin="0,8,0,0" Text="{Binding LoadingText}" Foreground="{DynamicResource SecondaryText}"
                               Visibility="{Binding LoadingVisibility}" />

                    <ItemsControl ItemsSource="{Binding Limits}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding PercentText}" FontWeight="SemiBold"
                                                   Foreground="{Binding Brush}" />
                                    </Grid>
                                    <ProgressBar Margin="0,6,0,5" Style="{StaticResource UsageBar}" Value="{Binding Fraction, Mode=OneWay}"
                                                 Foreground="{Binding Brush}" />
                                    <TextBlock Text="{Binding ResetText}" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                               Visibility="{Binding ResetVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,4,0,0" Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding BreakdownVisibility}">
                        <TextBlock Text="{Binding BreakdownHeader}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryText}" />
                        <ItemsControl ItemsSource="{Binding Breakdown}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Height="4" VerticalAlignment="Center" Style="{StaticResource UsageBar}"
                                                     Value="{Binding Fraction, Mode=OneWay}" Foreground="{DynamicResource NeutralBarBrush}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding PercentText}"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
