<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AIUsageBar"
        x:Class="AIUsageBar.PopupWindow"
        x:DataType="local:PopupViewModel"
        Title="AI Usage Bar"
        Width="356"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontSize="13">

    <Border x:Name="Card" Margin="8" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
            BoxShadow="0 2 16 0 #47000000">

        <StackPanel Margin="16,14,16,10" TextElement.Foreground="{DynamicResource PrimaryText}">
            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
                <Button Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding RefreshTip}" Command="{Binding RefreshCommand}" IsVisible="{Binding RefreshVisible}">
                    <PathIcon Data="{x:Static local:Icons.Refresh}" />
                </Button>
                <PathIcon HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"
                          Data="{x:Static local:Icons.Busy}" Foreground="{DynamicResource SecondaryText}"
                          IsVisible="{Binding LoadingVisible}" />
            </Grid>

            <!-- A desktop without a tray: how to reach the meter. -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ErrorBackground}"
                    IsVisible="{Binding Notice.Visible}">
                <DockPanel>
                    <PathIcon DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0" Width="14" Height="14"
                              Data="{x:Static local:Icons.Info}" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding Notice.Text}" TextWrapping="Wrap" FontSize="12" />
                </DockPanel>
            </Border>

            <!-- New version: the update button, its progress, or the result of "Check for updates". -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    IsVisible="{Binding Update.Visible}" Background="{Binding Update.Background}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Padding="12,3"
                            Content="{Binding Update.ButtonText}" ToolTip.Tip="{Binding Update.ButtonTip}"
                            Command="{Binding Update.Command}" IsVisible="{Binding Update.ButtonVisible}" />
                    <PathIcon DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"
                              Data="{Binding Update.Icon}" Foreground="{Binding Update.IconBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Update.Title}" FontWeight="{Binding Update.TitleWeight}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Update.Subtitle}" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   IsVisible="{Binding Update.SubtitleVisible}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tab strip: one tab per agent plus the Agents tab. Hidden with a single agent. -->
            <DockPanel Margin="0,8,0,0" IsVisible="{Binding TabStripVisible}">
                <!-- "+" keeps a narrow slot of its own; the agent tabs share the rest. -->
                <Button DockPanel.Dock="Right" Width="30" Classes="tab" Command="{Binding AgentsTab.SelectCommand}"
                        ToolTip.Tip="{Binding AgentsTab.AutomationName}" AutomationProperties.Name="{Binding AgentsTab.AutomationName}">
                    <StackPanel>
                        <PathIcon HorizontalAlignment="Center" Width="14" Height="14" Margin="0,1,0,1"
                                  Data="{x:Static local:Icons.Add}" Foreground="{Binding AgentsTab.StatusBrush}" />
                        <Border Height="2" Margin="0,5,0,0" Background="{Binding AgentsTab.UnderlineBrush}" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TabViewModel">
                            <Button Classes="tab" Width="{Binding Width}" Command="{Binding SelectCommand}"
                                    ToolTip.Tip="{Binding AutomationName}" AutomationProperties.Name="{Binding AutomationName}"
                                    Tag="{Binding Key}" PointerReleased="OnTabPointerReleased">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="16" Height="16" Source="{Binding Icon}" Opacity="{Binding IconOpacity}"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        <TextBlock Margin="4,0,0,0" FontSize="12.5" VerticalAlignment="Center" Text="{Binding Name}"
                                                   FontWeight="{Binding NameWeight}" IsVisible="{Binding NameVisible}" />
                                        <TextBlock Margin="3,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                   IsVisible="{Binding StatusVisible}" />
                                    </StackPanel>
                                    <Border Height="2" Margin="0,5,0,0" Background="{Binding UnderlineBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Scrolls when "All AIs together" (or the Agents tab) is taller than the screen allows. -->
            <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BodyContent">
                    <!-- Agents tab: every supported agent and whether it is connected. -->
                    <StackPanel IsVisible="{Binding Agents.Visible}">
                        <Border Height="1" Margin="0,0,0,12" Background="{DynamicResource Divider}" />
                        <TextBlock Text="{Binding Agents.Heading}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Agents.Welcome}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}" IsVisible="{Binding Agents.WelcomeVisible}" />
                        <ItemsControl ItemsSource="{Binding Agents.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:AgentRowViewModel">
                                    <Grid Margin="0,12,0,0" ColumnDefinitions="22,*,Auto">
                                        <PathIcon Margin="0,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="14" Height="14"
                                                  Data="{Binding Icon}" Foreground="{Binding IconBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Hint}" TextWrapping="Wrap" FontSize="11.5"
                                                       IsVisible="{Binding HintVisible}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" VerticalAlignment="Top" Margin="8,-4,0,0" Content="{Binding ToggleText}"
                                                  IsChecked="{Binding IsShown, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                                  IsVisible="{Binding ToggleVisible}" Focusable="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Margin="0,14,0,0" HorizontalAlignment="Right" Padding="14,4" Content="{Binding Agents.DoneText}"
                                Command="{Binding Agents.DoneCommand}" />
                    </StackPanel>

                    <!-- The selected service, or every service with "All AIs together". -->
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ProviderViewModel">
                                <StackPanel>
                                    <Border Height="1" Margin="0,12,0,12" Background="{DynamicResource Divider}" />
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                                    Background="{DynamicResource BadgeBackground}" IsVisible="{Binding PlanVisible}">
                                                <TextBlock Text="{Binding Plan}" FontSize="10.5" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Classes="icon small" HorizontalAlignment="Right" ToolTip.Tip="{Binding OpenTip}" Command="{Binding OpenCommand}">
                                            <PathIcon Data="{x:Static local:Icons.OpenExternal}" />
                                        </Button>
                                    </Grid>

                                    <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ErrorBackground}"
                                            IsVisible="{Binding ErrorVisible}">
                                        <DockPanel>
                                            <PathIcon DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0" Width="14" Height="14"
                                                      Data="{x:Static local:Icons.Warning}" Foreground="{DynamicResource WarningBrush}" />
                                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12" />
                                        </DockPanel>
                                    </Border>

                                    <!-- "Too many refreshes": not an error, the last numbers stay below. -->
                                    <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource BadgeBackground}"
                                            IsVisible="{Binding NoticeVisible}">
                                        <DockPanel>
                                            <PathIcon DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0" Width="14" Height="14"
                                                      Data="{x:Static local:Icons.Clock}" Foreground="{DynamicResource SecondaryText}" />
                                            <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" FontSize="12" />
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Margin="0,8,0,0" Text="{Binding LoadingText}" Foreground="{DynamicResource SecondaryText}"
                                               IsVisible="{Binding LoadingVisible}" />

                                    <ItemsControl ItemsSource="{Binding Limits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:LimitViewModel">
                                                <StackPanel Margin="0,10,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                                                        <TextBlock HorizontalAlignment="Right" Text="{Binding PercentText}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Brush}" />
                                                    </Grid>
                                                    <local:UsageBar Margin="0,6,0,5" Height="6" Fraction="{Binding Fraction}"
                                                                    Fill="{Binding Brush}" Track="{DynamicResource TrackBrush}" />
                                                    <TextBlock Text="{Binding ResetText}" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                               IsVisible="{Binding ResetVisible}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <DockPanel Margin="0,4,0,0">
                                                    <PathIcon DockPanel.Dock="Left" Width="12" Height="12" Margin="0,1,6,0" VerticalAlignment="Top"
                                                              Data="{x:Static local:Icons.Info}" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,12,0,0" IsVisible="{Binding BreakdownVisible}">
                                        <TextBlock Text="{Binding BreakdownHeader}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                        <ItemsControl ItemsSource="{Binding Breakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:BreakdownViewModel">
                                                    <Grid Margin="0,7,0,0" ColumnDefinitions="100,*,44">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <local:UsageBar Grid.Column="1" Height="4" VerticalAlignment="Center" Fraction="{Binding Fraction}"
                                                                        Fill="{DynamicResource NeutralBarBrush}" Track="{DynamicResource TrackBrush}" />
                                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding PercentText}"
                                                                   Foreground="{DynamicResource SecondaryText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Height="1" Margin="0,12,0,6" Background="{DynamicResource Divider}" />
            <Button x:Name="SettingsButton" Classes="icon" HorizontalAlignment="Right" ToolTip.Tip="{Binding SettingsTip}" Click="OnSettingsClick">
                <PathIcon Data="{x:Static local:Icons.Settings}" />
            </Button>
        </StackPanel>
    </Border>
</Window>
